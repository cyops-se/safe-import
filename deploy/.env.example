# Copy to deploy/.env and fill in. Never commit the real .env file.
# Generate secrets with: openssl rand -base64 32

NATS_PASSWORD_ENGINE=
NATS_PASSWORD_INNER=
NATS_PASSWORD_GATEKEEPER=
NATS_PASSWORD_OUTER=

# Optional: a fixed JWT signing key for si-engine (min 32 characters). If empty, a random
# key is generated and stored in the si-engine data volume.
SI_ENGINE_JWT_KEY=

# Host port for the administration UI. Bind it to a management interface, not to all interfaces.
SI_ENGINE_PUBLISH=127.0.0.1:7499

# Host address(es) where si-inner listens for DNS/HTTP(S) from the sensitive network
SI_INNER_BIND=0.0.0.0

# Directory on the host with myCA.pem and myCA.key (see install/generate-ca.sh)
SI_CA_DIR=/safe-import/ca
